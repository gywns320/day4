# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요 (.env 는 git에 올라가지 않습니다)

# Supabase  →  Project Settings > API Keys
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_public_또는_publishable_키

# Pixabay  →  https://pixabay.com/api/docs/  (로그인 후 문서 페이지에 키가 표시됨)
# VITE_ 접두사가 없는 이유: 브라우저에 노출되지 않고 서버(/api/pixabay)에서만 쓰기 위해서
PIXABAY_API_KEY=여기에_pixabay_api_키
